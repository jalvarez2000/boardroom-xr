<style>
  .root {
    flex-direction: column;
    width: 400px;
    height: 273px;
    padding: 12px;
    gap: 6px;
  }

  .eyebrow {
    color: #f5d90a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.2px;
  }

  .title {
    color: #fafaf7;
    font-size: 15px;
    font-weight: 700;
    line-height: 20px;
  }

  .status {
    color: #a1a1aa;
    font-size: 11px;
    line-height: 14px;
  }

  .page {
    flex-direction: column;
    gap: 6px;
  }

  .log {
    color: #e4e4e7;
    font-size: 10px;
    line-height: 13px;
    height: 100px;
  }

  .msg {
    color: #d4d4d8;
    font-size: 12px;
    line-height: 16px;
  }

  .row {
    flex-direction: row;
    gap: 6px;
  }

  .row-btn {
    flex-grow: 1;
  }
</style>
<Panel class="root">
  <div class="eyebrow">BOARDROOM</div>
  <div id="title" class="title">Boardroom</div>
  <div id="status" class="status">Meeting room</div>

  <div id="page-login" class="page">
    <div class="msg">Sign in on your phone or computer browser (or open the link with the token) and come back to the glasses.</div>
  </div>

  <div id="page-list" class="page">
    <div id="list-help" class="msg">Tap a meeting to join:</div>
    <Button id="m0">
      <ButtonIcon><LogIn></LogIn></ButtonIcon>
      <ButtonLabel id="m0-label">-</ButtonLabel>
    </Button>
    <Button id="m1">
      <ButtonIcon><LogIn></LogIn></ButtonIcon>
      <ButtonLabel id="m1-label">-</ButtonLabel>
    </Button>
    <Button id="m2">
      <ButtonIcon><LogIn></LogIn></ButtonIcon>
      <ButtonLabel id="m2-label">-</ButtonLabel>
    </Button>
    <Button id="new-btn">
      <ButtonIcon><Plus></Plus></ButtonIcon>
      <ButtonLabel>Create new meeting</ButtonLabel>
    </Button>
  </div>

  <div id="page-meeting" class="page">
    <div id="log" class="log">Just speak to address the committee.</div>
    <div class="row">
      <Button id="back-btn" class="row-btn">
        <ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon>
        <ButtonLabel>Meetings</ButtonLabel>
      </Button>
      <Button id="voice-btn" class="row-btn">
        <ButtonIcon><Volume2></Volume2></ButtonIcon>
        <ButtonLabel id="voice-label">Voice: on</ButtonLabel>
      </Button>
      <Button id="mic-btn" class="row-btn">
        <ButtonIcon><Mic></Mic></ButtonIcon>
        <ButtonLabel id="mic-label">Mic on</ButtonLabel>
      </Button>
      <Button id="docs-btn" class="row-btn">
        <ButtonIcon><FileText></FileText></ButtonIcon>
        <ButtonLabel id="docs-label">Docs</ButtonLabel>
      </Button>
    </div>
  </div>

  <div id="page-docs" class="page">
    <div class="row">
      <Button id="docs-prev"><ButtonIcon><ChevronLeft></ChevronLeft></ButtonIcon></Button>
      <div id="docs-help" class="msg row-btn">Tap a document to change its scope.</div>
      <Button id="docs-next"><ButtonIcon><ChevronRight></ChevronRight></ButtonIcon></Button>
    </div>
    <div class="row">
      <Button id="d0" class="row-btn"><ButtonLabel id="d0-label">-</ButtonLabel></Button>
      <Button id="d0-del"><ButtonIcon><Trash2></Trash2></ButtonIcon></Button>
    </div>
    <div class="row">
      <Button id="d1" class="row-btn"><ButtonLabel id="d1-label">-</ButtonLabel></Button>
      <Button id="d1-del"><ButtonIcon><Trash2></Trash2></ButtonIcon></Button>
    </div>
    <div class="row">
      <Button id="d2" class="row-btn"><ButtonLabel id="d2-label">-</ButtonLabel></Button>
      <Button id="d2-del"><ButtonIcon><Trash2></Trash2></ButtonIcon></Button>
    </div>
    <div class="row">
      <Button id="docs-back" class="row-btn">
        <ButtonIcon><ArrowLeft></ArrowLeft></ButtonIcon>
        <ButtonLabel>Back</ButtonLabel>
      </Button>
      <Button id="docs-up" class="row-btn">
        <ButtonIcon><Upload></Upload></ButtonIcon>
        <ButtonLabel>Upload</ButtonLabel>
      </Button>
    </div>
  </div>
</Panel>
