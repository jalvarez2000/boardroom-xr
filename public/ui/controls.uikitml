<style>
  .panel-root {
    flex-direction: column;
    width: 320px;
  }

  .content {
    flex-direction: column;
    gap: 4px;
    padding: 16px;
    padding-bottom: 10px;
  }

  .eyebrow {
    color: #f5d90a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.2px;
  }

  .heading {
    color: #fafaf7;
    font-size: 20px;
    font-weight: 700;
    line-height: 26px;
  }

  .subtitle {
    color: #d4d4d8;
    font-size: 12px;
    line-height: 16px;
    margin-top: 6px;
    max-width: 288px;
  }

  .button {
    justify-content: flex-start;
    margin-left: 16px;
    margin-right: 16px;
    margin-bottom: 10px;
  }

  .last {
    margin-bottom: 16px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="content">
    <div class="eyebrow">SALA DE REUNIONES</div>
    <div id="count-text" class="heading">Sala de reuniones</div>
    <div id="subtitle" class="subtitle">Los subtitulos aparecen aqui.</div>
  </div>
  <Button id="mic-btn" class="button">
    <ButtonIcon>
      <Mic></Mic>
    </ButtonIcon>
    <ButtonLabel id="mic-label" class="button-label">Hablar</ButtonLabel>
  </Button>
  <Button id="meet-btn" class="button last">
    <ButtonIcon>
      <Plus></Plus>
    </ButtonIcon>
    <ButtonLabel class="button-label">Nueva reunion</ButtonLabel>
  </Button>
</Panel>
